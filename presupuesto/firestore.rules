rules_version = '2';

// Solo los usuarios de esta lista pueden leer y escribir el presupuesto.
// Para dar acceso a alguien más: crea su usuario en Authentication y añade su email aquí.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in [
          'jose@boda-jose-oarda.app',
          'oarda@boda-jose-oarda.app'
        ];
    }
  }
}
